# Database
DB_HOST=localhost
DB_PORT=5434
DB_USER=league_user
DB_PASSWORD=league_pass
DB_NAME=league_manager

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# App
PORT=3000
NODE_ENV=development
# Origens do frontend permitidas no CORS (separadas por vírgula)
# FRONTEND_URL=https://seu-app.vercel.app
# Atrás de proxy (Render, nginx): TRUST_PROXY=1 para o rate limit ver o IP real
# TRUST_PROXY=1

# Banco em produção: use DATABASE_URL (Render) OU as variáveis DB_* acima. DB_SSL=true liga SSL.
# DATABASE_URL=postgres://user:pass@host:5432/db
# DB_SSL=true

# Admin seed (used only for the initial seed script)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
